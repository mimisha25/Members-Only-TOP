<%- include('./partials/header') %>
    <h2 class="text-light text-center">Edit Message</h2>

    <form class="row g-3 form-edit-product validated-form  bg-light p-3 mx-auto my-2" method="POST"
        action="/message/edit/<%= message.id %>" novalidate>
        <div class="col-md-12">
            <div class="input-group mb-3">
                <span class="input-group-text" id="basic-addon1">Title: </span>
                <input type="text" id="title" class="form-control" name="title" aria-label="Username"
                    aria-describedby="basic-addon1" required value="<%= message.title %>">
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>
        </div>

        <div class="col-md-12">
            <div class="input-group">
                <span class="input-group-text">Content: </span>
                <textarea required aria-label="With textarea" name="content" class="form-control" id="content" cols="10"
                    rows="5" minlength="30" maxlength="250"><%= message.content %></textarea>
                <div class="invalid-feedback">
                    The length of character must be between 30 and 250.
                </div>
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>
        </div>


        <div class="col-12">
            <a role="submit" class="btn btn-primary"> Submit</a>
            <a href="/forum" class="btn btn-success" role="button">Cancel</a>

        </div>
    </form>


    <%- include('./partials/validator', {name: 'validated-form' }) %>
        <%- include('./partials/footer') %>