<div class="modal fade" id="modalSheet" tabindex="-1" aria-labelledby="modalSheetLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title" id="modalSheetLabel">Notification</h5>
            </div>
            <div class="modal-body py-0">
                <p class="text-dark">
                    <%= success %>
                </p>
                <p class="text-danger">
                    <%= error %>
                </p>
            </div>
            <div class="modal-footer flex-column align-items-stretch w-100 gap-2 pb-3 border-top-0">
                <button type="button" class="btn btn-lg btn-primary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>