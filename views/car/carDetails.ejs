<%- include('../partials/header') %>

    <div class="container text-center product-details">
        <div class="row  img-product-div">
            <div class="col">
                <img class="img-product" src="<%=car.image%>" alt="">
            </div>
            <div class="col">
                <h3>
                    <%=car.title%>
                </h3>

                <div class="button-grp">

                    <%if(admin){%>
                        <a href="/car-details/<%=car.id%>/edit" class="edit-btn btn btn-warning  btn-sm"
                            role="button">Edit</a>
                        <form method="POST" action="/car-details/<%= car.id %>?_method=DELETE">
                            <button class="btn btn-danger  btn-sx" type="submit"> Delete</button>
                            <%}%>
                        </form> <a href="/cars" role="button" class="home-btn btn btn-primary  btn-sm">Go Back
                            Home</a>

                </div>

            </div>
        </div>
        <div class="row product-details-description">
            <div class="col">
                <h3>Description</h3>
                <p>
                    <%=car.description%>
                </p>
            </div>

        </div>
    </div>









    <%- include('../partials/footer') %>