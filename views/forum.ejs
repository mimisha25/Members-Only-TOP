<%- include('./partials/header') %>



    <div class=" text-center">
        <div class="row">


            <div class="col py-2 my-5 d-flex flex-column gap-3 ">
                <% if (user) { %>
                    <a href="/message/new" role="button" class="btn btn-warning">New message</a>
                    <% } %>
                        <a href="/forum" role="button" class="btn btn-primary">All messages</a>
                        <a href="/forum" role="button" class="btn btn-success">Tesla Discussion</a>
                        <a href="/forum" role="button" class="btn btn-success">Lamborghini Discussion</a>
                        <a href="/forum" role="button" class="btn btn-success">Maserati Discussion</a>
                        <a href="/forum" role="button" class="btn btn-success">Rolls Royce Discussion</a>
                        <a href="/forum" role="button" class="btn btn-success">Bugatti Discussion</a>
                        <a href="/forum" role="button" class="btn btn-success">Mercedes Discussion</a>
                        <a href="/forum" role="button" class="btn btn-success">Audi Discussion</a>
                        <a href="/forum" role="button" class="btn btn-success">Bentley Discussion</a>
                        <a href="/forum" role="button" class="btn btn-success">McLaren Discussion</a>
                        <a href="/forum" role="button" class="btn btn-success">Ferrari Discussion</a>
                        <a href="/forum" role="button" class="btn btn-success">Aston Martin Discussion</a>

            </div>
            <div class="col-7">



                <h1>Messages</h1>
                <% if (messages.length===0) { %>
                    <p>No messages available.</p>
                    <% } else { %>
                        <% messages.forEach(message=> { %>
                            <div class="card mt-2">
                                <div class="row g-0">
                                    <div class="col-md-4">

                                        <%- message.profile_picture %>

                                            <p>Author:
                                                <% if (user && (user.membership_status || user.admin)) { %>
                                                    <%= message.first_name %>
                                                        <%= message.last_name %>
                                                            <% } else { %>
                                                                *****
                                                                <% } %>
                                            </p>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="card-body forum-card">
                                            <% if (message.status==='inappropriate' && user.admin) { %>

                                                <h5 class="card-title" style="color: grey;">
                                                    <%= message.title %>
                                                </h5>
                                                <% } else{ %>
                                                    <h5>
                                                        <%= message.title %>
                                                    </h5>
                                                    <%}%>

                                                        <% if (message.status==='inappropriate' && user.admin) { %>
                                                            <p style="color: grey;">
                                                                <%= message.content %>
                                                            </p>

                                                            <% } else if (message.status==='inappropriate' &&
                                                                !user.admin) { %>
                                                                <p style="color: red; font-weight: bold;">
                                                                    This message has been removed for inappropriate
                                                                    content.
                                                                </p>
                                                                <% } else { %>
                                                                    <p>
                                                                        <%= message.content %>
                                                                    </p>
                                                                    <% } %>


                                                                        <p class="card-text">
                                                                            <small class="text-body-secondary">Last
                                                                                updated:
                                                                                <% if (user && (user.membership_status
                                                                                    || user.admin)) { %>
                                                                                    <%= date %>
                                                                                        <% } else { %>
                                                                                            *****
                                                                                            <% } %>
                                                                            </small>
                                                                        </p>

                                                                        <div
                                                                            class="d-flex flex-column forum-button gap-2">


                                                                            <% if (user&&(message.user_id===user.id)) {
                                                                                %>
                                                                                <form
                                                                                    action="/message/edit/<%= message.id %>"
                                                                                    method="GET">
                                                                                    <button type="submit"
                                                                                        class="btn btn-primary btn-sm">Edit</button>
                                                                                </form>
                                                                                <% } %>
                                                                                    <% if (user&&
                                                                                        (message.user_id===user.id ||
                                                                                        user.admin)) { %>
                                                                                        <form
                                                                                            action="/message/delete/<%= message.id %>"
                                                                                            method="POST">
                                                                                            <button type="submit"
                                                                                                class="btn btn-danger btn-sm">Delete</button>
                                                                                        </form>

                                                                                        <% } %>
                                                                                            <% if (user&&user.admin &&
                                                                                                message.status
                                                                                                !=='inappropriate' ) {
                                                                                                %>
                                                                                                <form
                                                                                                    action="/message/mark-inappropriate/<%= message.id %>"
                                                                                                    method="POST">
                                                                                                    <button
                                                                                                        type="submit"
                                                                                                        class="btn btn-warning btn-sm">Mark
                                                                                                        as
                                                                                                        Inappropriate</button>
                                                                                                </form>

                                                                                                <% } %>
                                                                        </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                                <% } %>
            </div>
            <div class="col my-5 py-2">
                <div class="card card-cover overflow-hidden text-bg-dark rounded-4 shadow-lg" style="background-image: url('https://digitalassets.tesla.com/tesla-contents/image/upload/f_auto,q_auto/Model-S-Performance-Mobile.jpg'); 
                   background-size: cover;  background-position: center;">
                    <div class="d-flex flex-column h-100 p-5 pb-3 text-white text-shadow-1">
                        <h3 class="pt-5 mt-5 mb-4 display-6 lh-1 fw-bold font-italic text-shadow-3">Tesla
                        </h3>
                        <ul class="d-flex list-unstyled mt-auto">
                            <li class="d-flex align-items-center me-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="black"
                                    class="bi bi-badge-ad-fill" viewBox="0 0 16 16">
                                    <path
                                        d="M11.35 8.337c0-.699-.42-1.138-1.001-1.138-.584 0-.954.444-.954 1.239v.453c0 .8.374 1.248.972 1.248.588 0 .984-.44.984-1.2zm-5.413.237-.734-2.426H5.15l-.734 2.426h1.52z" />
                                    <path
                                        d="M2 2a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zm6.209 6.32c0-1.28.694-2.044 1.753-2.044.655 0 1.156.294 1.336.769h.053v-2.36h1.16V11h-1.138v-.747h-.057c-.145.474-.69.804-1.367.804-1.055 0-1.74-.764-1.74-2.043v-.695zm-4.04 1.138L3.7 11H2.5l2.013-5.999H5.9L7.905 11H6.644l-.47-1.542H4.17z" />
                                </svg>
                                <small class="text-dark">Tesla</small>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="card card-cover overflow-hidden text-bg-dark rounded-4 my-3 shadow-lg" style="background-image: url('https://upload.wikimedia.org/wikipedia/commons/thumb/f/f2/2024_Rolls-Royce_Spectre_in_Midnight_Sapphire_over_Silver%2C_front_left.jpg/560px-2024_Rolls-Royce_Spectre_in_Midnight_Sapphire_over_Silver%2C_front_left.jpg'); 
                background-size: cover;  background-position: center;">
                    <div class="d-flex flex-column h-100 p-5 pb-3 text-white text-shadow-1">
                        <h3 class="pt-5 mt-5 mb-4 display-6 lh-1 fw-bold font-italic text-shadow-3">Rolls Royce
                        </h3>
                        <ul class="d-flex list-unstyled mt-auto">
                            <li class="d-flex align-items-center me-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="white"
                                    class="bi bi-badge-ad-fill" viewBox="0 0 16 16">
                                    <path
                                        d="M11.35 8.337c0-.699-.42-1.138-1.001-1.138-.584 0-.954.444-.954 1.239v.453c0 .8.374 1.248.972 1.248.588 0 .984-.44.984-1.2zm-5.413.237-.734-2.426H5.15l-.734 2.426h1.52z" />
                                    <path
                                        d="M2 2a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zm6.209 6.32c0-1.28.694-2.044 1.753-2.044.655 0 1.156.294 1.336.769h.053v-2.36h1.16V11h-1.138v-.747h-.057c-.145.474-.69.804-1.367.804-1.055 0-1.74-.764-1.74-2.043v-.695zm-4.04 1.138L3.7 11H2.5l2.013-5.999H5.9L7.905 11H6.644l-.47-1.542H4.17z" />
                                </svg>
                                <small class="text-light">Rolls Royce</small>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <%- include('./partials/footer') %>