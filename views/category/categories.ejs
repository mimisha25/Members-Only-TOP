<%- include('../partials/header') %>

    <section class="py-4 text-center container section-title">
        <div class="row py-lg-3">
            <div class="col-lg-6 col-md-8 mx-auto">
                <h1 class="fw-light">Categories</h1>
                <p class="lead category-text">Experience the pinnacle of automotive engineering with the world's most
                    prestigious car
                    brands. From the timeless elegance of Rolls-Royce to the innovative power of Tesla, the luxury car
                    market offers unparalleled craftsmanship, performance, and cutting-edge technology. Explore iconic
                    brands such as Mercedes-Benz, BMW, Aston Martin, Ferrari, Lamborghini, and many more, each offering
                    a unique driving experience.</p>
                <%if(admin){%><a href="/categories/add" role="button" class="btn btn-primary">Add category</a>
                    <%}%>
            </div>
        </div>
    </section>


    <div class="products d-flex flex-wrap justify-content-evenly  gap-4">

        <% categories.forEach(category=> { %>

            <div class="col">
                <div class="card  h-100 mx-auto p-4" style="width: 23rem;">

                    <div class="card-body">
                        <div class=" d-inline-flex gap-5">
                            <img src="<%=category.icon%>" class="icon">
                            <div class="d-flex flex-column gap-2">
                                <h5 class="card-title  text-center">
                                    <%= category.name %>
                                </h5>
                                <p class="card-text text-center">
                                    <%= category.description.length> 100 ? category.description.substring(0,
                                        100) +
                                        '...'
                                        :
                                        category.description %>
                                </p>
                            </div>

                        </div>

                        <div class="card-footer text-body-secondary">
                            <%if(admin){%>
                                <form action="/categories/archive/<%= category.id %>" method="POST"
                                    style="display:inline;">
                                    <button type="submit" class="btn btn-warning btn-sm">Archive
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="white"
                                            class="bi bi-archive-fill" viewBox="0 0 16 16">
                                            <path
                                                d="M12.643 15C13.979 15 15 13.845 15 12.5V5H1v7.5C1 13.845 2.021 15 3.357 15zM5.5 7h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1 0-1M.8 1a.8.8 0 0 0-.8.8V3a.8.8 0 0 0 .8.8h14.4A.8.8 0 0 0 16 3V1.8a.8.8 0 0 0-.8-.8z" />
                                        </svg>
                                    </button>
                                </form>

                                <form action="/categories/prevent-deletion/<%= category.id %>" method="POST"
                                    style="display:inline;">
                                    <button type="submit" class="btn btn-danger btn-sm">Delete
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13"
                                            fill="currentColor" class="bi bi-trash3-fill" viewBox="0 0 16 16">
                                            <path
                                                d="M11 1.5v1h3.5a.5.5 0 0 1 0 1h-.538l-.853 10.66A2 2 0 0 1 11.115 16h-6.23a2 2 0 0 1-1.994-1.84L2.038 3.5H1.5a.5.5 0 0 1 0-1H5v-1A1.5 1.5 0 0 1 6.5 0h3A1.5 1.5 0 0 1 11 1.5m-5 0v1h4v-1a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5M4.5 5.029l.5 8.5a.5.5 0 1 0 .998-.06l-.5-8.5a.5.5 0 1 0-.998.06m6.53-.528a.5.5 0 0 0-.528.47l-.5 8.5a.5.5 0 0 0 .998.058l.5-8.5a.5.5 0 0 0-.47-.528M8 4.5a.5.5 0 0 0-.5.5v8.5a.5.5 0 0 0 1 0V5a.5.5 0 0 0-.5-.5" />
                                        </svg>
                                    </button>
                                </form>
                                <%}%>

                                    <a href="/categories/<%= category.name %>" class="btn btn-primary btn-sm">
                                        Details <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                            fill="currentColor" class="bi bi-arrow-right" viewBox="0 0 16 16">
                                            <path fill-rule="evenodd"
                                                d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8" />
                                        </svg></a>
                        </div>

                    </div>
                </div>
            </div>
            <% }) %>
    </div>


    <%- include('../partials/footer') %>