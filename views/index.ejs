<%- include('./partials/header') %>



    <div class=" text-center">
        <div class="row">

            <!-- Left Bar -->
            <div class="col border" style="background-color:#CCD5AE">
                <% if (user) { %>
                    <a href="/message/new">Create a new message</a>
                    <% } %>
                        <% if (user) { %>
                            <a href="/logout">Log Out</a>
                            <% } %>
            </div>
            <div class="col-7 border" style="background-color:#E0E5B6">
                <!-- Left Bar -->


                <h1>Messages</h1>
                <% if (messages.length===0) { %>
                    <p>No messages available.</p>
                    <% } else { %>
                        <% messages.forEach(message=> { %>
                            <div class="card mt-3" style="max-width: 100%; background-color: #FEFAE0">
                                <div class="row g-0">
                                    <div class="col-md-4">
                                        <!-- Display message image or placeholder -->
                                        <%- message.profile_picture %> <!-- Embed SVG directly -->

                                            <h4>Author:
                                                <% if (user && (user.membership_status || user.admin)) { %>
                                                    <%= message.first_name %>
                                                        <%= message.last_name %>
                                                            <% } else { %>
                                                                *****
                                                                <% } %>
                                            </h4>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="card-body">
                                            <!-- Message Title -->
                                            <% if (message.status==='inappropriate' && user.admin) { %>

                                                <h5 class="card-title" style="color: grey;">
                                                    <%= message.title %>
                                                </h5>
                                                <% } else{ %>
                                                    <h5>
                                                        <%= message.title %>
                                                    </h5>
                                                    <%}%>

                                                        <!-- Inappropriate Message Logic -->
                                                        <% if (message.status==='inappropriate' && user.admin) { %>
                                                            <p style="color: grey;">
                                                                <%= message.content %>
                                                            </p>

                                                            <% } else if (message.status==='inappropriate' &&
                                                                !user.admin) { %>
                                                                <p style="color: red; font-weight: bold;">
                                                                    This message has been removed for inappropriate
                                                                    content.
                                                                </p>
                                                                <% } else { %>
                                                                    <p>
                                                                        <%= message.content %>
                                                                    </p>
                                                                    <% } %>

                                                                        <!-- Timestamp -->
                                                                        <p class="card-text">
                                                                            <small class="text-body-secondary">Last
                                                                                updated:
                                                                                <% if (user && (user.membership_status
                                                                                    || user.admin)) { %>
                                                                                    <%= message.timestamp %>
                                                                                        <% } else { %>
                                                                                            *****
                                                                                            <% } %>
                                                                            </small>
                                                                        </p>

                                                                        <!-- Edit/Delete and Mark Inappropriate buttons (for owner or admin) -->

                                                                        <% if (user&&(message.user_id===user.id)) { %>
                                                                            <!-- Edit Button -->
                                                                            <form
                                                                                action="/message/edit/<%= message.id %>"
                                                                                method="GET">
                                                                                <button type="submit"
                                                                                    class="btn btn-primary btn-sm">Edit</button>
                                                                            </form>
                                                                            <% } %>
                                                                                <% if (user&& (message.user_id===user.id
                                                                                    || user.admin)) { %>
                                                                                    <!-- Delete Button -->
                                                                                    <form
                                                                                        action="/message/delete/<%= message.id %>"
                                                                                        method="POST">
                                                                                        <button type="submit"
                                                                                            class="btn btn-danger btn-sm">Delete</button>
                                                                                    </form>

                                                                                    <% } %>
                                                                                        <!-- Mark as Inappropriate (only for Admins) -->
                                                                                        <% if (user&&user.admin &&
                                                                                            message.status
                                                                                            !=='inappropriate' ) { %>
                                                                                            <form
                                                                                                action="/message/mark-inappropriate/<%= message.id %>"
                                                                                                method="POST">
                                                                                                <button type="submit"
                                                                                                    class="btn btn-warning btn-sm">Mark
                                                                                                    as
                                                                                                    Inappropriate</button>
                                                                                            </form>

                                                                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                                <% } %>
            </div>
            <div class="col border" style="background-color:#CCD5AE">
                3 of 3
            </div>
        </div>

    </div>

    <%- include('./partials/footer') %>